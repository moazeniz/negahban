[Unit]
Description=MeowMeow synthetic monitor: probe Liara apps, update SLOs and the status page
Documentation=https://github.com/moazeniz/negahban/blob/main/docs/OPERATIONS.md
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
DynamicUser=yes
StateDirectory=meow-monitor
WorkingDirectory=/opt/meow-platform
Environment=MONITOR_MANIFEST=/opt/meow-platform/infra/liara.yaml
EnvironmentFile=-/etc/meow-platform/monitor.env
# Token for POST /api/status/ingest on Negahban; only this one value is exposed to the unit.
LoadCredential=status-ingest-token:/etc/meow-platform/status-ingest-token
ExecStart=/usr/bin/python3 /opt/meow-platform/ops/monitor/probe.py run
# Exit 1 means "an app is down", which is data, not a unit failure.
SuccessExitStatus=1
TimeoutStartSec=55
Nice=5
# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=
UMask=0027
