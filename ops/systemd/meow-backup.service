[Unit]
Description=MeowMeow daily Liara disk backups (native where available, off-platform export everywhere)
Documentation=https://github.com/moazeniz/negahban/blob/main/docs/OPERATIONS.md
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
DynamicUser=yes
StateDirectory=meow-backup
StateDirectoryMode=0700
WorkingDirectory=/opt/meow-platform
# Liara API credentials: LIARA_API_TOKEN, LIARA_TEAM_ID, LIARA_API_BASE (mode 600, root-owned)
LoadCredential=liara.env:/etc/meow-platform/liara.env
ExecStart=/bin/sh -c 'set -a; . "$CREDENTIALS_DIRECTORY/liara.env"; set +a; exec /usr/bin/python3 /opt/meow-platform/ops/backup/liara_backup.py run -f /opt/meow-platform/infra/liara.yaml --out "$STATE_DIRECTORY"'
TimeoutStartSec=3h
Nice=10
IOSchedulingClass=idle
# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=
UMask=0077
