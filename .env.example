# Negahban configuration — copy to .env (git-ignored) and fill in. Never commit real values.
# On Liara, set these as app env vars (the full set; Liara replaces all vars on every update).

# --- Liara access (secret: LIARA_API_TOKEN) ---
LIARA_API_TOKEN=<liara-api-token>
LIARA_TEAM_ID=<liara-team-id>
LIARA_NETWORK_ID=<liara-network-id>
LIARA_API_BASE=https://api.iran.liara.ir
LIARA_DNS_BASE=https://dns-service.liara.ir/api/v1
# 1 = never send write calls to Liara (recommended for local development)
LIARA_DRY_RUN=1

# --- LLM via BoxAPI (secret: BOXAPI_KEYS, comma-separated, rotated) ---
BOXAPI_BASE_URL=https://ai.boxapi.ir/ai/v1
BOXAPI_KEYS=<key1>,<key2>,<key3>
NEGAHBAN_MODEL=openai/gpt-6-luna

# --- Storage and access control (secrets) ---
DATA_DIR=./data
ADMIN_PASSWORD=<strong-password>
SESSION_SECRET=<openssl rand -hex 32>
MCP_TOKEN=<openssl rand -hex 32>
WATCHDOG_TOKEN=<openssl rand -hex 32>
# 0 only for plain-HTTP localhost
SECURE_COOKIES=0

# --- Monitoring ---
SELF_APP=negahban-sre
MONITOR_APPS=demo-shop
ORCH_ENABLED=1
ORCH_INTERVAL=60

# --- Demo target app ---
DEMO_APP=demo-shop
DEMO_SRC=./demo-shop
DEMO_CHAOS_TOKEN=<openssl rand -hex 16>
